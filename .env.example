# Acheron Docker Compose configuration
# Copy to .env and customize as needed.

# Start the local stub fleet for the default Quick Start. Clear this variable
# before enabling a runpod-* profile so only the selected edge is registered.
COMPOSE_PROFILES=sim

# Optional comma-separated Compose worker IDs allowed to use bearer-authenticated
# HTTP for local simulation/edge services. Leave empty for the built-in list;
# arbitrary remote plaintext workers are never allowed by default.
# ACHERON_INSECURE_HTTP_WORKER_IDS=

# Optional static shared secret for worker registration. Leave unset for the
# Compose file-backed auto-mint path at /data/jobs/.registration_token in the
# named acheron-data volume. An explicit value is static, externally managed,
# and must be coordinated with workers; it is never silently overwritten by
# token rotation. Keep this assignment in one place; do not append a second
# token assignment after restarting your shell.
ACHERON_REGISTRATION_TOKEN=

# Standalone workers may use an explicit env token or this reload-aware file
# source. Repository Compose workers receive the file mapping automatically
# from the shared acheron-data volume.
# ACHERON_WORKER__REGISTRATION_TOKEN_FILE=/data/jobs/.registration_token

# Optional bearer token for operator-only /admin mutations. Keep this
# separate from ACHERON_REGISTRATION_TOKEN; unset disables admin mutations.
ACHERON_ADMIN_TOKEN=

# Dashboard: trust the X-Forwarded-User header from a reverse proxy that
# authenticates the user and strips the header. Set to 1 only when the
# dashboard is behind a trusted reverse proxy (nginx, Caddy, etc.).
# Default is 0 (unauthenticated).
ACHERON_TRUST_REVERSE_PROXY=0

# Optional deployed-image identity metadata exposed by GET /version.
# These values are descriptive build metadata, not runtime configuration or secrets.
# ACHERON_BUILD_SHA=
# ACHERON_BUILD_TIME=2026-07-30T12:00:00Z
# ACHERON_BUILD_BRANCH=master
# ACHERON_BUILD_DIRTY=false
# ACHERON_BUILD_IMAGE=acheron
# ACHERON_BUILD_REGISTRY=ghcr.io

# --- RunPod Serverless workers (Layer 8a+) ---
# Set these to enable one or more runpod-* profiles in docker-compose.yml.
# Leave commented to run the local HTTP stub workers instead.

# Your RunPod account API key (https://api.runpod.io/settings).
# RUNPOD_API_KEY=

# Endpoint IDs created with `runpodctl serverless create` or the RunPod
# dashboard. Each endpoint template must reference the matching GHCR image,
# a GPU suited to that worker, and the HF-cache network volume.
# QWEN3TTS_RUNPOD_ENDPOINT_ID=
# GRANITE_SPEECH_RUNPOD_ENDPOINT_ID=
# TRANSLATEGEMMA_RUNPOD_ENDPOINT_ID=
# TRANSLATEGEMMA_MODEL_ID=google/translategemma-12b-it

# Edge container runtime overrides. Set one worker ID/host pair for the
# active profile; Compose forwards these generic names to the SDK settings.
# Qwen3 TTS:       qwen3tts-1 / qwen3tts-edge
# Granite Speech:  granite-speech-edge / granite-speech-edge
# TranslateGemma:  translategemma-edge / translategemma-edge
# ACHERON_WORKER__WORKER_ID=qwen3tts-1
# ACHERON_WORKER__WORKER_HOST=qwen3tts-edge
# ACHERON_WORKER__PRICE_SOURCE=runpod            # runpod | static | zero
# ACHERON_WORKER__SECURE_CLOUD=false             # quote community-cloud rate
# ACHERON_WORKER__EXECUTION_TIMEOUT_S=1800
